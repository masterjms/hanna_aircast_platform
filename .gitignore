# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# 환경 변수 — *.example 만 커밋한다. 실제 값은 PC 마다 다르다.
.env
.env.*
!.env.example
!.env.local.example
!.env.device.example
!.env.prod.example

# 런타임 데이터 (로컬 개발용 볼륨)
/data/
/var/
/backend/data/

# 에디터 — tasks.json 은 팀이 공유하는 실행 태스크라 예외로 커밋한다.
.vscode/*
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db

# TLS 인증서 · MQTT 비밀번호 — 서버에서 생성되며 저장소에 올리지 않는다
infra/certs/
infra/mosquitto/config/passwd
# 디렉터리가 아니라 내용물을 제외한다 — 디렉터리를 제외하면
# git 이 안으로 들어가지 않아 .gitkeep 예외가 먹지 않는다.
infra/secrets/*
!infra/secrets/.gitkeep
