# xWIFI 운영서버 환경 변수
# 복사해서 .env 로 쓴다:  cp .env.example .env

# ── 앱 ────────────────────────────────────────────────
APP_ENV=dev                       # dev | prod
LOG_LEVEL=INFO
# 백엔드가 듣는 포트. Icecast 가 8000 을 써야 해서(단말 펌웨어 고정값) 8080 으로 비켜났다.
APP_PORT=8080
# 단말이 접근하는 공개 주소. FILE_START 의 https_url 을 만들 때 쓴다.
# 실단말 테스트에서는 localhost 가 아니라 이 PC 의 LAN IP 여야 한다.
PUBLIC_BASE_URL=http://localhost:8080
# 개발 중 프론트 dev 서버 오리진 (쉼표 구분). prod 에서는 비워둔다.
CORS_ORIGINS=http://localhost:5173

# ── DB ────────────────────────────────────────────────
POSTGRES_USER=xwifi
POSTGRES_PASSWORD=xwifi-dev-pw
POSTGRES_DB=xwifi
DATABASE_URL=postgresql+asyncpg://xwifi:xwifi-dev-pw@localhost:5432/xwifi

# ── 인증 ──────────────────────────────────────────────
# prod 에서는 반드시 교체:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-32b+
JWT_EXPIRE_MINUTES=720

# ── MQTT ──────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_ROOT=iotradio

# ── Icecast (실시간 방송) ─────────────────────────────
# 서버 -> Icecast (source PUT).
# 포트 8000 은 문서(Icecast_구성작업_지시서)와 단말 펌웨어 고정값에 맞춘 것이다.
# 현재 테스트 펌웨어는 stream_url 을 안 읽고 <ip>:8000/live 로 직접 붙는다.
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_SOURCE_USER=source
ICECAST_SOURCE_PASSWORD=source123
# 단말이 스트림을 받아가는 공개 주소.
# 마운트는 /live/<마을8자리>/<세션id> 형태로 이 뒤에 붙는다.
#   예) http://localhost:8000/live/00000001/43
# 운영에서는 nginx 가 /live/ 를 Icecast 로 프록시하므로 https://<도메인> 을 쓴다.
ICECAST_PUBLIC_BASE_URL=http://localhost:8000

# ── TTS (Google Cloud Text-to-Speech) ─────────────────
# google = 실제 합성 / dev = ffmpeg 톤 (자격증명 없이 파이프라인만 시험할 때)
TTS_ENGINE=dev
# 자격증명은 google-auth 기본 체인을 따른다:
#   1) 아래 경로의 서비스 계정 JSON
#   2) gcloud auth application-default login 으로 만든 사용자 자격증명
#   3) GCE/Cloud Run 에 붙은 서비스 계정 (운영에서 가장 안전 — 키 파일이 없다)
# 필요한 권한은 roles/cloudtts.user 하나이고, 프로젝트에서 Cloud TTS API 를 켜야 한다.
#GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# ── 파일 저장 ─────────────────────────────────────────
FILE_ROOT=./data/files
DOWNLOAD_TOKEN_TTL_SEC=600         # 일반 파일 10분
OTA_TOKEN_TTL_SEC=7200             # OTA pkg 2시간

# ── 운영 파라미터 ─────────────────────────────────────
DEVICE_ONLINE_THRESHOLD_SEC=300    # 최근 STATUS 5분 이내 = 온라인
CONFIG_RECONCILE_INTERVAL_SEC=3600 # CONFIG 재발행 주기

# 실시간 방송 시작 후 이 시간(초) 안에 마이크가 안 붙으면 서버가 자동 종료한다.
# 화면에는 ON AIR 인데 스피커는 조용한 "무음 방송"을 막는다. 0 이면 끈다.
LIVE_UPLINK_GRACE_SEC=30
