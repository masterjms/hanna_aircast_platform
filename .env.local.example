# ── 프로파일: local — 목 단말로 개발할 때 ────────────────────────────
#   XWIFI_PROFILE=local  로 켠다. .env 를 읽은 뒤 이 파일이 덮어쓴다.
#
#   .env.local 로 복사해서 쓴다:  cp .env.local.example .env.local
#   (.env.local 은 gitignore 된다 — PC 마다 다를 수 있어서)
#
# 전부 localhost 다. 목 단말이 같은 PC 에서 돌기 때문에 이게 맞고,
# 브라우저 마이크도 localhost 에서만 열린다(보안 컨텍스트).

PUBLIC_BASE_URL=http://localhost:8080
ICECAST_PUBLIC_BASE_URL=http://localhost:8000

# AWS/Google 자격증명 없이 파이프라인만 돌려본다. 소리는 삐 소리다.
TTS_ENGINE=dev

# 실시간 방송에서 오디오가 이 시간(초) 이상 끊기면 서버가 방송을 자동 종료한다.
# (마이크가 한 번도 안 붙은 경우와 붙었다 끊긴 경우를 같이 본다.)
# 단말은 스트림이 끊겨도 재접속하지 않으므로(ESP32 정정 260824) 기다려도 회복되지
# 않는다 — 방치하면 ON AIR 인데 소리는 안 나가고 대상 단말이 겹침 검사에 묶인다.
# icecast.xml 의 source-timeout(60s)보다 반드시 작아야 한다. 0 이면 끈다.
LIVE_UPLINK_GRACE_SEC=30
