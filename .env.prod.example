# ══════════════════════════════════════════════════════════════════
#  xWIFI 운영 서버 (hanna-aircast.co.kr) 환경 변수
#
#    cp .env.prod.example .env    후 <> 부분을 채운다.
#
#  ⚠ 이 파일을 채운 결과(.env)는 저장소에 올리지 않는다.
#    담당자가 안전한 곳(비밀번호 관리자 등)에 별도 보관한다 —
#    이게 없으면 서버가 사라졌을 때 복구가 불가능하다.
# ══════════════════════════════════════════════════════════════════

# ── 앱 ────────────────────────────────────────────────
APP_ENV=prod
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# 단말이 파일을 받아가는 공개 주소 (FILE_START 의 https_url).
# 파일 다운로드는 단말이 https 를 지원하므로 처음부터 TLS 로 간다.
PUBLIC_BASE_URL=https://hanna-aircast.co.kr

# 운영에서는 프론트를 nginx 가 같은 도메인으로 서빙하므로 CORS 가 필요 없다.
CORS_ORIGINS=

# ── DB (RDS) ──────────────────────────────────────────
# RDS 콘솔의 "엔드포인트" 를 그대로 넣는다.
#
# ⚠ ?ssl=require 를 반드시 붙인다. RDS 는 기본 파라미터 그룹에서
#   rds.force_ssl=1 이라 평문 연결을 거부한다 —
#   빠뜨리면 "no pg_hba.conf entry ... no encryption" 으로 막힌다.
#   (force_ssl 을 끄지 말 것. 클라이언트가 SSL 을 쓰는 쪽이 맞다.)
#
# 암호에 @ : / ? # % 가 들어 있으면 URL 인코딩해야 한다:
#   python3 -c "import urllib.parse,getpass;print(urllib.parse.quote(getpass.getpass(),safe=''))"
DATABASE_URL=postgresql+asyncpg://xwifi:<RDS_마스터_암호>@<RDS_엔드포인트>:5432/xwifi?ssl=require

# ── 인증 ──────────────────────────────────────────────
# 반드시 새로 만든다:  openssl rand -base64 48
JWT_SECRET=<생성한_시크릿>
# 운영에서는 12시간보다 짧게 잡는 편이 안전하다.
JWT_EXPIRE_MINUTES=240

# ── MQTT ──────────────────────────────────────────────
# scripts/setup-mqtt-users.sh 가 출력한 값
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=xwifi-server
MQTT_PASSWORD=<서버용_비밀번호>
# 백엔드는 같은 도커 내부망에서 브로커에 붙으므로 TLS 가 필요 없다.
# 인터넷을 건너오는 단말만 8883 을 쓴다.
MQTT_TLS=false
MQTT_TOPIC_ROOT=iotradio

# ── Icecast ───────────────────────────────────────────
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_SOURCE_USER=source
# 서로 다른 값으로 만든다:  openssl rand -base64 24
ICECAST_SOURCE_PASSWORD=<소스_비밀번호>
ICECAST_ADMIN_PASSWORD=<관리자_비밀번호>

# 단말이 스트림을 받아가는 공개 주소.
#
# ⚠ 전환기에는 반드시 http 다. 단말 Icecast 클라이언트에 TLS 검증이 아직 없어서
#   https 를 주면 접속에 실패한다(ESP32 회신 260824 §3). 서버도 https 로 시작하는
#   stream_url 은 발행 전에 거부한다.
#   펌웨어 TLS 반영 후 → https://hanna-aircast.co.kr 로 바꾸고 8000 을 닫는다.
ICECAST_PUBLIC_BASE_URL=http://hanna-aircast.co.kr:8000

# ── TTS (Google Cloud Text-to-Speech) ─────────────────
TTS_ENGINE=google
# 컨테이너 안에서 본 경로다. 실제 파일은 호스트의 infra/secrets/google-tts.json 이고
# scripts/setup-tts-credentials.sh 가 컨테이너 사용자 소유로 놓아준다.
#
# 조직 정책(iam.disableServiceAccountKeyCreation)으로 서비스 계정 키를 만들 수 없어
# gcloud auth application-default login 으로 받은 자격증명을 쓴다:
#   gcloud auth application-default login --no-launch-browser
#   gcloud auth application-default set-quota-project <프로젝트ID>   ← 빠뜨리면 API 호출 실패
#   sudo bash scripts/setup-tts-credentials.sh
#
# TTS 를 아직 안 쓸 거면 이 줄을 주석 처리한다 — 나머지 방송 기능은 정상 동작한다.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-tts.json

# ── 파일 저장 ─────────────────────────────────────────
FILE_ROOT=/var/lib/iotradio/files
DOWNLOAD_TOKEN_TTL_SEC=600
OTA_TOKEN_TTL_SEC=7200

# ── 운영 파라미터 ─────────────────────────────────────
DEVICE_ONLINE_THRESHOLD_SEC=300
CONFIG_RECONCILE_INTERVAL_SEC=3600
# icecast.xml 의 source-timeout(60s)보다 반드시 작아야 한다.
LIVE_UPLINK_GRACE_SEC=30
