# ── 프로파일: device — 실물 ESP32 와 통신할 때 ───────────────────────
#   XWIFI_PROFILE=device  로 켠다. .env 를 읽은 뒤 이 파일이 덮어쓴다.
#
#   .env.device 로 복사해서 쓴다:  cp .env.device.example .env.device
#
# 단말은 localhost 로 서버에 올 수 없다 — 단말 입장에서 자기 자신이 된다.
# 그래서 이 PC 의 LAN IP 가 필요한데, `auto` 를 쓰면 기동할 때 알아서 채운다.
# 노트북과 데스크톱을 오가도 파일을 고칠 필요가 없다.
#
# 자동 탐지가 엉뚱한 주소(가상 어댑터 등)를 고르면 IP 를 직접 적는다:
#   PUBLIC_BASE_URL=http://192.168.0.41:8080

# 단말이 파일을 받아가려면 모든 인터페이스에서 들어야 한다.
# 127.0.0.1 이면 방화벽을 열어도 단말이 못 닿는다(FILE_ABORT NET_ERROR).
APP_HOST=0.0.0.0
PUBLIC_BASE_URL=http://auto:8080
ICECAST_PUBLIC_BASE_URL=http://auto:8000

# 실물 단말 테스트에서는 진짜 음성이 나와야 한다.
# 자격증명이 아직 없으면 dev 로 두고 나중에 바꾼다.
TTS_ENGINE=dev
#GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# 실시간 방송에서 오디오가 이 시간(초) 이상 끊기면 서버가 방송을 자동 종료한다.
# (마이크가 한 번도 안 붙은 경우와 붙었다 끊긴 경우를 같이 본다.)
# 단말은 스트림이 끊겨도 재접속하지 않으므로(ESP32 정정 260824) 기다려도 회복되지
# 않는다 — 방치하면 ON AIR 인데 소리는 안 나가고 대상 단말이 겹침 검사에 묶인다.
# icecast.xml 의 source-timeout(60s)보다 반드시 작아야 한다. 0 이면 끈다.
LIVE_UPLINK_GRACE_SEC=30
